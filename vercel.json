{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://apex-fitness-fd32.onrender.com/api/:path*"
    },
    {
      "source": "/exercise-media/:path*",
      "destination": "https://apex-fitness-fd32.onrender.com/exercise-media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
