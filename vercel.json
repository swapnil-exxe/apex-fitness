{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://apex-fitness-fd32.onrender.com/api/:path*"
    },
    {
      "source": "/exercise-media/:path*",
      "destination": "https://duartesantos8.github.io/openGym/exercise-media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
